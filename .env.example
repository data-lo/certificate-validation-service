# Puerto HTTP. 3000 lo usa signature-server, 3001 signature-app y 3002 seal-service.
PORT=3003

# Clave que los consumidores envían en el header x-api-key. OBLIGATORIA: sin ella el servicio no
# arranca. Debe ser IDÉNTICA a CERTIFICATE_VALIDATION_SERVICE_API_KEY en signature-server.
API_KEY=replace-with-a-long-random-key

# Respondedor OCSP del SAT y tiempo máximo de espera (ms). Opcionales: estos son sus defaults.
OCSP_URL=https://cfdi.sat.gob.mx/edofiel
OCSP_TIMEOUT_MS=5000

# ---- Incidencias de disponibilidad de OCSP ----
# Postgres: base PROPIA del servicio (no la de signature-server). Las migraciones corren al arrancar.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=certificate_validation_db

# Redis: lock distribuido entre réplicas (llave certificate-validation-service:incident).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka: se publica y se consume certificate-validation.ocsp-validation-failed.
KAFKA_BROKER=localhost:9094
KAFKA_CLIENT_ID=certificate-validation-service
KAFKA_CONSUMER_GROUP_ID=certificate-validation-service-consumer

# Correos al equipo operativo. Sin ellos el servicio arranca, pero los avisos no salen (queda en el log
# y en service_incidents.last_notification_error).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
INCIDENT_ALERT_RECIPIENTS=ops@example.com,guardia@example.com

# Fallos (intentos afectados + chequeos fallidos) a partir de los que se envía el aviso. Default 3.
INCIDENT_ALERT_THRESHOLD=3

# Chequeo de salud del cron (cada 5 minutos). Timeout por defecto: OCSP_TIMEOUT_MS.
OCSP_HEALTH_CHECK_TIMEOUT_MS=5000
# Opcional y recomendado: un .cer vigente emitido por el SAT, en Base64, para que el chequeo sea una
# consulta OCSP real. Sin él, el chequeo sólo comprueba que OCSP_URL responde.
OCSP_HEALTH_CHECK_CERTIFICATE=
